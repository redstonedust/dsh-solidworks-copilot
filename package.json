{
  "name": "dsh-solidworks-copilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "DSH plugin + CLI for the SolidWorks automation skill: composer/sidebar UI, prompt & template tools, 2 agent presets, and an idempotent skill deployer.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.js",
    "generate.js",
    "content/*.js",
    "lib/*.mjs",
    "bin/*.mjs",
    "templates/*.md",
    "docs/*.md",
    "cordis.patch.yml",
    "presets/*.yml",
    "prompts/*.md",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "licenses/*.txt",
    "README.md",
    "README.en.md",
    "docs/images/*.png",
    "scripts/*.mjs",
    "scripts/*.py"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/swas-cad.patch.yml",
        "./presets/swas-review.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "import:content": "node scripts/import-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "node --check index.js && node --check catalog.js && node --check generate.js && node --check client.js",
    "swas": "node bin/swas.mjs",
    "swas:agents": "node bin/swas.mjs agents",
    "swas:specs": "node bin/swas.mjs templates",
    "deploy:dry": "node bin/swas.mjs install --dry-run"
  },
  "license": "MIT",
  "author": "redstonedust",
  "repository": {
    "type": "git",
    "url": "https://github.com/redstonedust/dsh-solidworks-copilot.git"
  },
  "homepage": "https://github.com/redstonedust/dsh-solidworks-copilot#readme",
  "bugs": {
    "url": "https://github.com/redstonedust/dsh-solidworks-copilot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "solidworks",
    "cad",
    "prompt",
    "agent-preset",
    "skill"
  ],
  "bin": {
    "swas": "./bin/swas.mjs"
  }
}
