{
  "name": "dsh-solidworks-copilot",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "SolidWorks 自动化副驾：提示词生成、设计思路、模板预设、技巧库与交付门禁（面向 solidworks-automation-skill）",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.js",
    "generate.js",
    "content/*.js",
    "cordis.patch.yml",
    "presets/*.yml",
    "prompts/*.md",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "licenses/*.txt",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/swas-cad.patch.yml",
        "./presets/swas-review.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "import:content": "node scripts/import-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "node --check index.js && node --check catalog.js && node --check generate.js && node --check client.js"
  },
  "license": "MIT",
  "author": "redstonedust",
  "repository": {
    "type": "git",
    "url": "https://github.com/redstonedust/dsh-solidworks-copilot.git"
  },
  "homepage": "https://github.com/redstonedust/dsh-solidworks-copilot#readme",
  "bugs": {
    "url": "https://github.com/redstonedust/dsh-solidworks-copilot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "solidworks",
    "cad",
    "prompt",
    "agent-preset",
    "skill"
  ]
}
